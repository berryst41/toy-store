{
  "name": "AI 딸기",
  "short_name": "AI 딸기",
  "description": "일정·할 일·쿨메신저·구글(캘린더·메일·드라이브·시트)까지 말로 시키는 AI berryst",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f5fb",
  "theme_color": "#5b4fd6",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "f",
          "accept": [
            "audio/*",
            "text/plain",
            ".txt",
            "image/*",
            "application/pdf",
            ".m4a",
            ".mp3",
            ".wav",
            ".amr",
            ".3gp"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "🎙️ 회의 녹음",
      "short_name": "회의 녹음",
      "url": "./?rec=1",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "📝 새 노트",
      "short_name": "새 노트",
      "url": "./?note=1",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}